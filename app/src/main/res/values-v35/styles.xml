<resources>

    <!-- Android 15+ can flash a black navigation bar when the system slide transition exposes the task background. -->
    <style name="AppTheme.ActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_fade_out</item>
    </style>

</resources>
